{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chronolens-deepseek-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-05-16",
  "vars": {
    "ALLOWED_EXTENSION_ORIGINS": "chrome-extension://"
  },
  // Uncomment after creating a Rate Limiting binding in Cloudflare.
  // The Worker code will use this binding automatically when present.
  // "unsafe": {
  //   "bindings": [
  //     {
  //       "name": "RATE_LIMITER",
  //       "type": "ratelimit",
  //       "namespace_id": "1001",
  //       "simple": {
  //         "limit": 20,
  //         "period": 60
  //       }
  //     }
  //   ]
  // },
  "observability": {
    "enabled": true
  }
}
